---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { galleries, galleryTitle } from '../../gallery';
import { url } from '../../url';
---
<Layout title="Fotos">
  <div class="section-head">
    <div>
      <span class="eyebrow">Galerie</span>
      <h1>Fotos</h1>
    </div>
  </div>
  <ul class="cards">
    {Object.entries(galleries).map(([slug, imgs]) => (
      <li>
        <a class="media" href={url(`/galerie/${slug}/`)} tabindex="-1" aria-hidden="true"><Image src={imgs[0]} alt="" width={480} /></a>
        <div class="body">
          <h2><a href={url(`/galerie/${slug}/`)}>{galleryTitle(slug)}</a></h2>
          <span class="meta">{imgs.length} Fotos</span>
        </div>
      </li>
    ))}
  </ul>
</Layout>
