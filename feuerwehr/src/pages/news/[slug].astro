---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url, formatDate, withBase } from '../../url';

export const getStaticPaths = (async () =>
  (await getCollection('news')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
---
<Layout title={entry.data.title} full>
  <header class="post-head">
    <div class="container prose">
      <a class="back" href={url('/news/')}>← Alle Beiträge</a>
      <div class="meta">
        {entry.data.category && <span class="chip">{entry.data.category}</span>}
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      </div>
      <h1>{entry.data.title}</h1>
    </div>
  </header>
  <article class="container prose post-body">
    <Fragment set:html={withBase(entry.rendered?.html)} />
  </article>
</Layout>
