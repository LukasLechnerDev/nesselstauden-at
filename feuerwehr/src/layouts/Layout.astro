---
import { getCollection } from 'astro:content';
import { url } from '../url';

interface Props { title?: string; full?: boolean; }
const { title, full } = Astro.props;
const pages = (await getCollection('pages')).filter((p) => !p.data.hidden).sort((a, b) => a.data.order - b.data.order);
const here = Astro.url.pathname;
const links = [
  { href: url('/news/'), label: 'Aktuelles', active: here.includes('/news/') || here.includes('/kategorie/') },  { href: url('/mannschaft/'), label: 'Mannschaft', active: here === url('/mannschaft/') },
  { href: url('/feuerwehrhaus/'), label: 'Feuerwehrhaus', active: here === url('/feuerwehrhaus/') },
  { href: url('/#ueber-uns'), label: 'Über uns' },
  { href: url('/#kontakt'), label: 'Kontakt' },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Freiwillige Feuerwehr Geyersberg – für Geyersberg, Nesselstauden, Scheiblwies, Maria Langegg und Plaimberg." />
    <meta name="theme-color" content="#a10f15" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title ? `${title} · FF Geyersberg` : 'Freiwillige Feuerwehr Geyersberg'}</title>
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={url('/')}>
          <img class="geyer" src={url('/img/stories/feuerwehrgeyer.jpg')} alt="" width="40" height="40" />
          <strong>FF Geyersberg</strong>
        </a>
        <nav aria-label="Hauptnavigation">
          {links.map((l) => <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>)}        </nav>
      </div>
    </header>
    <main id="main" class:list={[!full && 'container page']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container cols">
        <div>
          <strong>Freiwillige Feuerwehr Geyersberg</strong>
          <p>Geyersberg 11<br />3122 Gansbach</p>
        </div>
        <div>
          <strong>Feuerwehr</strong>
          <p>{pages.filter((p) => p.id !== 'erfolge').map((p) => <><a href={url(`/${p.id}/`)}>{p.data.title}</a><br /></>)}</p>
        </div>
        <div>
          <strong>Bewerbe</strong>
          <p><a href={url('/erfolge/')}>Erfolge</a></p>
        </div>
      </div>
      <div class="container fine">© {new Date().getFullYear()} FF Geyersberg · Abschnitt Mautern · Bezirk Krems</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --red: #a10f15; --red-hover: #7b0b12; --red-deep: #640b0f; --red-tint: #fbeeee;
    --ink: #1b1716; --ink-soft: #57504e; --line: #e9e4e2; --bg: #faf8f7; --card: #fff;
    --radius: 14px;
    --shadow: 0 1px 2px rgb(27 23 22 / .06), 0 8px 24px -12px rgb(27 23 22 / .18);
    --font-display: 'Barlow Condensed', 'Arial Narrow', system-ui, sans-serif;
    --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 96px; -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.65; }
  img { max-width: 100%; height: auto; }
  a { color: var(--red); text-underline-offset: 3px; }
  a:hover { color: var(--red-hover); }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 700; line-height: 1.1; letter-spacing: .005em; margin: 0 0 .5em; text-wrap: balance; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.25rem); }
  .container { width: min(1120px, 100% - 32px); margin-inline: auto; }
  .page { padding-block: clamp(40px, 6vw, 72px); min-height: 60vh; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 1rem; top: 1rem; background: #fff; padding: .5rem; z-index: 99; }

  .site-header { position: sticky; top: 0; z-index: 10; background: rgb(255 255 255 / .9); backdrop-filter: saturate(1.6) blur(12px); border-bottom: 1px solid var(--line); border-top: 4px solid var(--red); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; flex-wrap: wrap; padding-block: 8px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .brand strong { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: .01em; line-height: 1.1; }
  .geyer { width: 40px; height: 40px; padding: 3px; border-radius: 50%; background: #fff; object-fit: contain; box-shadow: 0 0 0 2px var(--red); }
  .site-header nav { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
  .site-header nav a { color: var(--ink); text-decoration: none; font-weight: 500; font-size: .95rem; padding: .4em .8em; border-radius: 999px; }
  .site-header nav a:hover, .site-header nav a[aria-current] { background: var(--red-tint); color: var(--red); }  @media (max-width: 560px) {
    .site-header nav { width: 100%; justify-content: space-between; }
    .site-header nav a { padding-inline: .5em; font-size: .9rem; }
  }

  .site-footer { background: var(--red-deep); color: rgb(255 255 255 / .8); padding-block: 48px 24px; font-size: .95rem; }
  .site-footer .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; }
  .site-footer strong { color: #fff; font-family: var(--font-display); font-size: 1.2rem; letter-spacing: .02em; }
  .site-footer p { margin: .4em 0 0; }
  .site-footer a { color: #fff; }  .site-footer .fine { margin-top: 40px; padding-top: 20px; border-top: 1px solid rgb(255 255 255 / .15); font-size: .82rem; color: rgb(255 255 255 / .6); }

  .eyebrow { display: inline-block; font-size: .8rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--red); }
  .btn { display: inline-flex; align-items: center; gap: .5em; padding: .75em 1.3em; border-radius: 999px; font-weight: 600; font-size: .95rem; text-decoration: none; transition: background .15s, color .15s, transform .15s; }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary { background: #fff; color: var(--red-deep); }
  .btn-primary:hover { background: var(--red-tint); color: var(--red-deep); }
  .btn-ghost { color: #fff; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .5); }
  .btn-ghost:hover { color: #fff; background: rgb(255 255 255 / .1); }
  .btn-red { background: var(--red); color: #fff; }
  .btn-red:hover { background: var(--red-hover); color: #fff; }
  .section { padding-block: clamp(56px, 8vw, 96px); }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }
  .section-head h1, .section-head h2 { font-size: clamp(2rem, 4vw, 2.75rem); margin: .15em 0 0; }
  .chip { display: inline-block; font-size: .75rem; font-weight: 600; letter-spacing: .04em; padding: .25em .7em; border-radius: 999px; background: var(--red-tint); color: var(--red); text-decoration: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: -16px 0 32px; }
  .chips .chip { font-size: .85rem; padding: .4em 1em; }
  .chips .chip[aria-current] { background: var(--red); color: #fff; }
  .meta { color: var(--ink-soft); font-size: .9rem; }
  .pager { display: flex; justify-content: space-between; align-items: center; margin-top: 40px; }

  /* cards: news list and gallery index */
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; padding: 0; margin: 0; list-style: none; }
  .cards > li { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform .2s, box-shadow .2s; }
  .cards > li:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgb(27 23 22 / .06), 0 18px 40px -16px rgb(100 11 15 / .35); }
  .cards .media { display: block; aspect-ratio: 16 / 10; overflow: hidden;
    /* placeholder for posts without a photo */
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"><path d="M100 30c10 28 42 44 42 84a42 42 0 0 1-84 0c0-20 10-32 20-42 0 14 6 24 14 28-4-26 2-48 8-70z" fill="white" fill-opacity=".22"/></svg>') center / 30% no-repeat, linear-gradient(135deg, var(--red), var(--red-deep)); }
  .cards .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cards .body { padding: 20px 22px 24px; }
  .cards .meta { display: flex; align-items: center; gap: 10px; font-size: .85rem; margin-bottom: 10px; }
  .cards h2, .cards h3 { font-size: 1.5rem; margin-bottom: .35em; }
  .cards h2 a, .cards h3 a { color: var(--ink); text-decoration: none; }
  .cards h2 a:hover, .cards h3 a:hover { color: var(--red); }
  .cards p { margin: 0; color: var(--ink-soft); font-size: .95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  /* imported legacy HTML in posts and pages */
  .prose { max-width: 760px; margin-inline: auto; }
  .legacy img { border-radius: 10px; box-shadow: var(--shadow); }
  .legacy table { display: block; overflow-x: auto; border-collapse: collapse; max-width: 100%; }
  .legacy td { vertical-align: top; padding: .2rem .5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: .5rem; }
  .grid img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; display: block; }
  .post-head { background: linear-gradient(140deg, var(--red) 0%, var(--red-deep) 80%); color: #fff; padding-block: 48px 56px; margin-bottom: 48px; }
  .post-head .back { color: rgb(255 255 255 / .8); text-decoration: none; font-size: .9rem; }
  .post-head .back:hover { color: #fff; }
  .post-head .meta { display: flex; gap: 10px; align-items: center; margin: 20px 0 12px; color: rgb(255 255 255 / .8); }
  .post-head .chip { background: rgb(255 255 255 / .15); color: #fff; }
  .post-head h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); margin: 0; }
  .post-body { padding-bottom: 80px; }
</style>
