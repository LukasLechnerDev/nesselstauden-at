---
import { getCollection } from 'astro:content';
import { url } from '../url';

interface Props { title?: string; }
const { title } = Astro.props;
const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const here = Astro.url.pathname;
const nav = [
  { href: url('/news/'), label: 'News' },
  ...pages.map((p) => ({ href: url(`/${p.id}/`), label: p.data.title })),
  { href: url('/galerie/'), label: 'Fotos' },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SV Knudde – Sportverein aus Nesselstauden-Geyersberg. News, Mannschaft, Termine und Fotos." />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <title>{title ? `${title} · SV Knudde` : 'SV Knudde'}</title>
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <header>
      <div class="wrap bar">
        <a class="brand" href={url('/')}>SV <span>Knudde</span></a>
        <a class="home" href={url('/../')}>← Nesselstauden</a>
      </div>
      <nav aria-label="Hauptnavigation" class="wrap">
        {nav.map((n) => <a href={n.href} aria-current={here.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer><div class="wrap">SV Knudde · Nesselstauden-Geyersberg</div></footer>
  </body>
</html>

<style is:global>
  :root {
    --pitch: #74911d; --lime: #c5e05a; --ink: #22241f; --muted: #5d6157; --bg: #f3f5ee; --card: #fff; --line: #dfe4d4;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: var(--ink); background: var(--bg);
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.6; }
  a { color: #4f6512; }
  .wrap { max-width: 64rem; margin: 0 auto; padding: 0 1rem; }
  .skip { position: absolute; left: -999px; } .skip:focus { left: 1rem; top: 1rem; background: #fff; padding: .5rem; z-index: 9; }
  header {
    color: #fff;
    background: repeating-linear-gradient(90deg, #2a2c26 0 4rem, #303329 4rem 8rem);
    border-bottom: 5px solid var(--lime);
  }
  .bar { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; }
  .brand { color: #fff; text-decoration: none; font-size: clamp(1.8rem, 5vw, 2.6rem); font-weight: 900; font-style: italic; text-transform: uppercase; letter-spacing: -.02em; }
  .brand span { color: var(--lime); }
  .home { color: #fff; font-size: .9rem; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem; padding: .5rem 1rem .75rem; }
  nav a { color: #fff; text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: .85rem; letter-spacing: .05em; padding: .35rem .7rem; border-radius: 999px; }
  nav a:hover, nav a[aria-current] { background: var(--lime); color: var(--ink); }
  main { padding-top: 2rem; padding-bottom: 3rem; min-height: 60vh; }
  h1, h2 { line-height: 1.15; }
  h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); font-style: italic; font-weight: 900; text-transform: uppercase; margin-top: 0; }
  .meta { color: var(--muted); font-size: .9rem; }
  .tag { display: none; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; padding: 0; list-style: none; }
  .cards li { background: var(--card); border: 1px solid var(--line); border-left: 6px solid var(--pitch); border-radius: 4px; padding: 1rem 1.2rem; }
  .cards h2 { font-size: 1.1rem; margin: 0 0 .3rem; }
  .cards a { color: var(--ink); text-decoration: none; } .cards a:hover { color: var(--pitch); }
  .pager { display: flex; justify-content: space-between; margin-top: 2rem; }
  article { background: var(--card); border: 1px solid var(--line); border-radius: 4px; padding: clamp(1rem, 3vw, 2rem); }
  .legacy img { max-width: 100%; height: auto; }
  .legacy table { display: block; overflow-x: auto; border-collapse: collapse; max-width: 100%; }
  .legacy td { vertical-align: top; padding: .2rem .5rem; border-bottom: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: .5rem; }
  .grid img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; display: block; }
  footer { background: #2a2c26; color: #c9cdbf; padding: 1.5rem 0; font-size: .9rem; }
</style>
