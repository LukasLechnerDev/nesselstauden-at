---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { url, formatDate, withBase } from '../../url';

export const getStaticPaths = (async () =>
  (await getCollection('news')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
---
<Layout title={entry.data.title}>
  <article>
    {entry.data.category && <span class="tag">{entry.data.category}</span>}
    <h1>{entry.data.title}</h1>
    <p class="meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p>
    <Fragment set:html={withBase(entry.rendered?.html)} />
  </article>
  <p><a href={url('/news/')}>← Alle Beiträge</a></p>
</Layout>
